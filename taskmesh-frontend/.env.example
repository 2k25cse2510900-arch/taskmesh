# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/taskmesh?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/taskmesh"

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace_me"
CLERK_SECRET_KEY="sk_test_replace_me"
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Cloudinary signed uploads
CLOUDINARY_CLOUD_NAME="replace_me"
CLOUDINARY_API_KEY="replace_me"
CLOUDINARY_API_SECRET="replace_me"

# AI adapter selected by the deployment
AI_PROVIDER="replace_me"
AI_PROVIDER_KEY="replace_me"
AI_MODEL="gpt-4o-mini"
# Optional fallback used by both OpenAI integrations when provider-specific keys are omitted
OPENAI_API_KEY=""

# Video transcription (OpenAI supports MP4 uploads up to 25 MB)
TRANSCRIPTION_PROVIDER="openai"
TRANSCRIPTION_PROVIDER_KEY="replace_me"
TRANSCRIPTION_MODEL="gpt-transcribe"
